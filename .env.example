# ─────────────────────────────────────────────────────────────
#  fabrashion-backend — environment variables
#  Copy to `.env` and fill in. NEVER commit the real .env.
# ─────────────────────────────────────────────────────────────

# Runtime
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed CORS origins (mobile dev usually needs none;
# add your web admin / tunnel URLs here). Use * only in development.
CORS_ORIGINS=*
# pino log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=debug

# PostgreSQL (matches docker-compose.yml defaults)
DATABASE_URL=postgresql://fabrashion:fabrashion@localhost:5433/fabrashion?schema=public

# Redis (matches docker-compose.yml defaults)
REDIS_URL=redis://localhost:6380

# JWT (Phase 1) — dev/test run on safe built-in defaults; production REQUIRES real
# 32+ char secrets (boot fails if a `dev-` default is used with NODE_ENV=production).
# JWT_ACCESS_SECRET=<random 32+ char string>
# JWT_REFRESH_SECRET=<different random 32+ char string>
# JWT_ACCESS_TTL=15m
# JWT_REFRESH_TTL_DAYS=30

# Phone-OTP login (Phase 1). Login is phone-only; email is profile data.
# OTP_TTL_MINUTES=5
# OTP_MAX_ATTEMPTS=5
# OTP_RESEND_COOLDOWN_SECONDS=30
# Return the OTP in the /otp/request response for local dev (walk the flow without SMS).
# Automatically forced OFF when NODE_ENV=production.
# OTP_EXPOSE_CODE=true

# ── Added in later phases (kept here as documentation) ──

# Pricing / shipping (Phase 4) — values in paise
# SHIPPING_FLAT_PAISE=4000
# FREE_SHIPPING_THRESHOLD_PAISE=49900

# MSG91 OTP (Phase 1)
# MSG91_AUTH_KEY=
# MSG91_SENDER_ID=
# MSG91_OTP_TEMPLATE_ID=

# PhonePe (Phase 4)
# PHONEPE_ENV=SANDBOX
# PHONEPE_MERCHANT_ID=
# PHONEPE_SALT_KEY=
# PHONEPE_SALT_INDEX=1

# AWS S3 + CloudFront (Phase 2)
# AWS_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_BUCKET=
# CLOUDFRONT_URL=
